<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      AMOLED surface: true-black ground, gray accent, dark system bars. The activities still draw
      their own views; this only fixes the window chrome and font so there is no flash of a light
      platform theme before the first frame.

      Theme.OwnFate.Base holds everything API 26 understands. The versioned copies add the newer
      window attributes without asking older platforms to parse them.
    -->
    <style name="Theme.OwnFate.Base" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/ownfate_page</item>
        <item name="android:statusBarColor">@color/ownfate_page</item>
        <item name="android:navigationBarColor">@color/ownfate_page</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="android:colorAccent">@color/ownfate_primary</item>
    </style>

    <style name="Theme.OwnFate" parent="Theme.OwnFate.Base" />
</resources>

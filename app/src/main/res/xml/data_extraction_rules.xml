<?xml version="1.0" encoding="utf-8"?>
<!--
  OwnFate has no account, no cloud and no backup worth restoring. Settings and streaks are local;
  keeping them out of cloud backup and device transfer also keeps the block/allow lists from
  following a user to a new phone without their knowledge.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
